# ---- wall heat baths: outer 1-sigma layer = rigid anchor (no drift),
#      inner layer = Langevin bath (the heat-exchange surface) ----
group   wbot type 2
960 atoms in group wbot
group   wtop type 3
960 atoms in group wtop
region  rbot_d block INF INF INF INF 0.0     ${zdlo} units box
region  rbot_d block INF INF INF INF 0.0     1 units box
region  rtop_d block INF INF INF INF ${zdhi} ${Lz}  units box
region  rtop_d block INF INF INF INF 22.811015779523 ${Lz}  units box
region  rtop_d block INF INF INF INF 22.811015779523 23.811015779523  units box
group   drive_bot region rbot_d
480 atoms in group drive_bot
group   drive_top region rtop_d
480 atoms in group drive_top
group   drive    union drive_bot drive_top
960 atoms in group drive
group   bath_bot subtract wbot drive_bot
480 atoms in group bath_bot
group   bath_top subtract wtop drive_top
480 atoms in group bath_top

velocity all   create ${Tbot} ${seed} mom yes rot yes dist gaussian
velocity all   create 1.0 ${seed} mom yes rot yes dist gaussian
velocity all   create 1.0 22 mom yes rot yes dist gaussian
velocity drive set 0.0 0.0 0.0                 # anchor still by default (sheared scripts override)
fix     nve  all  nve
fix     pin  drive setforce 0.0 0.0 0.0        # rigid wall anchor
fix     bbot bath_bot langevin ${Tbot} ${Tbot} ${tdamp} ${seed1} tally yes
fix     bbot bath_bot langevin 1.0 ${Tbot} ${tdamp} ${seed1} tally yes
fix     bbot bath_bot langevin 1.0 1.0 ${tdamp} ${seed1} tally yes
fix     bbot bath_bot langevin 1.0 1.0 0.5 ${seed1} tally yes
fix     bbot bath_bot langevin 1.0 1.0 0.5 25 tally yes
fix     btop bath_top langevin ${Ttop} ${Ttop} ${tdamp} ${seed2} tally yes
fix     btop bath_top langevin 1.0 ${Ttop} ${tdamp} ${seed2} tally yes
fix     btop bath_top langevin 1.0 1.0 ${tdamp} ${seed2} tally yes
fix     btop bath_top langevin 1.0 1.0 0.5 ${seed2} tally yes
fix     btop bath_top langevin 1.0 1.0 0.5 29 tally yes
fix     boxwall all wall/reflect zlo EDGE zhi EDGE   # bounce stray atoms off z-faces
timestep ${dt}
timestep 0.005
thermo       1000
thermo_style custom step temp pe press
minimize     1.0e-4 1.0e-6 1000 10000          # settle seeding overlaps
