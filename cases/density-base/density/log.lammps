variable nrho  equal round(v_Lz/v_binw)        # bin count from the chosen bin width (binw, default 0.1 sigma)
variable dzrho equal v_Lz/v_nrho
compute crho fluid chunk/atom bin/1d z lower ${dzrho} units box
compute crho fluid chunk/atom bin/1d z lower 0.100046284787912 units box
fix     frho fluid ave/chunk 100 ${nrep} ${nfreq} crho density/number         file day1_density.profile
fix     frho fluid ave/chunk 100 500 ${nfreq} crho density/number         file day1_density.profile
fix     frho fluid ave/chunk 100 500 50000 crho density/number         file day1_density.profile

# optional orientation trajectory for VMD/OVITO (production only; off by default, pass -var dump 1).
# element names are only for viewer colouring; the model is a generic LJ channel.
if "${dump} > 0" then   "dump dvmd all xyz 1000 day1_traj.xyz"   "dump_modify dvmd element Ar Kr Kr sort id"

run ${nprod}
run 50000
