# #####################################################################
#  DAY 2 - PART 2 : liquid-vapour slab (free-surface LJ)
#  A single-component Lennard-Jones liquid slab, centred in a long
#  fully-periodic box (slab normal = z), so its two exposed faces relax
#  into liquid-vapour interfaces. One run feeds both Part-2 exercises:
#    (1) the z density profile + the diagonal pressure tensor -> surface
#        tension gamma  (analyse_liquid_vapour.py)
#    (2) the trajectory -> the intrinsic (capillary-wave) surface
#        (intrinsic_surface.py), with -var dump 1
#
#  Density only:   lmp_serial -in liquid_vapour.in                    (Sheet 2)
#  Surface tension: add  -var localstress 1                           (Sheet 3 needs this)
#  Intrinsic surface: add  -var dump 1                                (Sheet 4)
#  with a knob:    lmp_serial -in liquid_vapour.in -var T 1.0
# #####################################################################

# ---- parameters (override any with -var NAME value) ----
variable T       index 0.85    # temperature (T* < Tc* so a liquid slab coexists with vapour). Knob: -var T 1.0
variable rho_l   index 0.7     # seed liquid density. Knob: follow the phase diagram with rho_v
variable rho_v   index 0.05    # seed vapour density
variable rcut    index 2.5     # LJ cutoff (sigma). Knob: -var rcut 2.0 lowers gamma
variable Lx_t    index 10.0    # lateral box target (sigma)
variable Ly_t    index 10.0
variable Lz_t    index 90.0    # long axis = slab normal: slab + two vapour gaps
variable tslab   index 20.0    # initial liquid-slab thickness (sigma), centred in z
variable bin     index 0.5     # z-profile bin width (sigma)
variable dt      index 0.005   # timestep (tau)
variable tdamp   index 1.0     # Nose-Hoover damping (tau)
variable nequil  index 10000   # equilibration steps
variable nprod   index 100000  # production steps. LIVE default 100000; the shipped reference uses 500000
variable seed    index 90187   # RNG seed for the initial velocities. The ensemble varies this per replica
variable dump    index 0       # -var dump 1 -> write slab_traj.xyz (production) for view_domain / intrinsic
variable localstress index 0   # -var localstress 1 -> also bin the diagonal pressure tensor for gamma
variable outdir  index .       # output directory (the ensemble sets one per replica)
# guard: never let -var outdir target the shipped read-only reference ensemble. Each
# reference/ dir carries a .is_reference marker; is_file() matches it however the path is
# written (trailing slash, ./, absolute) and does NOT break the default outdir '.' (which
# has no marker). A student's own ensemble goes to output_*/ here, read with --ensemble-mine.
variable outdir_is_reference equal is_file(${outdir}/.is_reference)
variable outdir_is_reference equal is_file(./.is_reference)
if "${outdir_is_reference} > 0" then "print 'ERROR: -var outdir must not target reference/ (the shipped reference ensemble is read-only; read it with --ensemble)'" "quit 1"
shell mkdir ${outdir}
shell mkdir .
# clear ALL regeneratable outputs at the start, so an aborted or reconfigured run
# cannot leave a stale profile/params/trajectory for the analyser to misread as this
# run's (the conditional stress/traj especially, but also a density/params left by a
# run that later aborts before overwriting them).
shell rm -f ${outdir}/slab_density.profile ${outdir}/slab_stress.profile ${outdir}/slab_params.txt ${outdir}/slab_traj.xyz ${outdir}/slab_density.png ${outdir}/slab_pressure.png ${outdir}/slab_gamma_convergence.png
shell rm -f ./slab_density.profile ${outdir}/slab_stress.profile ${outdir}/slab_params.txt ${outdir}/slab_traj.xyz ${outdir}/slab_density.png ${outdir}/slab_pressure.png ${outdir}/slab_gamma_convergence.png
shell rm -f ./slab_density.profile ./slab_stress.profile ${outdir}/slab_params.txt ${outdir}/slab_traj.xyz ${outdir}/slab_density.png ${outdir}/slab_pressure.png ${outdir}/slab_gamma_convergence.png
shell rm -f ./slab_density.profile ./slab_stress.profile ./slab_params.txt ${outdir}/slab_traj.xyz ${outdir}/slab_density.png ${outdir}/slab_pressure.png ${outdir}/slab_gamma_convergence.png
shell rm -f ./slab_density.profile ./slab_stress.profile ./slab_params.txt ./slab_traj.xyz ${outdir}/slab_density.png ${outdir}/slab_pressure.png ${outdir}/slab_gamma_convergence.png
shell rm -f ./slab_density.profile ./slab_stress.profile ./slab_params.txt ./slab_traj.xyz ./slab_density.png ${outdir}/slab_pressure.png ${outdir}/slab_gamma_convergence.png
shell rm -f ./slab_density.profile ./slab_stress.profile ./slab_params.txt ./slab_traj.xyz ./slab_density.png ./slab_pressure.png ${outdir}/slab_gamma_convergence.png
shell rm -f ./slab_density.profile ./slab_stress.profile ./slab_params.txt ./slab_traj.xyz ./slab_density.png ./slab_pressure.png ./slab_gamma_convergence.png

# ---- derived geometry (snap the box to whole liquid-FCC lattice constants) ----
variable af    equal (4.0/v_rho_l)^(1.0/3.0)   # FCC lattice constant at the liquid density
variable Lx    equal round(v_Lx_t/v_af)*v_af
variable Ly    equal round(v_Ly_t/v_af)*v_af
variable Lz    equal round(v_Lz_t/v_af)*v_af
variable zlo_s equal 0.5*(v_Lz-v_tslab)         # central slab band [zlo_s, zhi_s]
variable zhi_s equal 0.5*(v_Lz+v_tslab)

# vacuum-gap guard: the slab-to-image separation across the z-PBC is (Lz - tslab);
# fail loud if it drops below 2*rcut + 1 sigma, so a mis-sized box cannot silently
# couple the slab to its periodic image.
if "$(v_Lz-v_tslab) < $(2.0*v_rcut+1.0)" then "print 'ERROR: vapour gap (Lz-tslab) < 2*rcut+1 -> slab sees its image'" "quit 1"

# ---- system: long p p p box, ONE LJ type, central FCC slab + vapour on both sides ----
units      lj
atom_style atomic
boundary   p p p
region     sim block 0 ${Lx} 0 ${Ly} 0 ${Lz} units box
region     sim block 0 10.7268424211588 0 ${Ly} 0 ${Lz} units box
region     sim block 0 10.7268424211588 0 10.7268424211588 0 ${Lz} units box
region     sim block 0 10.7268424211588 0 10.7268424211588 0 89.390353509657 units box
create_box 1 sim
Created orthogonal box = (0 0 0) to (10.726842 10.726842 89.390354)
  1 by 1 by 8 MPI processor grid

# liquid slab (central band in z, seeded at rho_l)
lattice      fcc ${rho_l}
lattice      fcc 0.7
Lattice spacing in x,y,z = 1.7878071 1.7878071 1.7878071
region       liquid block INF INF INF INF ${zlo_s} ${zhi_s} units box
region       liquid block INF INF INF INF 34.6951767548285 ${zhi_s} units box
region       liquid block INF INF INF INF 34.6951767548285 54.6951767548285 units box
create_atoms 1 region liquid
Created 1656 atoms
  using lattice units in orthogonal box = (0 0 0) to (10.726842 10.726842 89.390354)
  create_atoms CPU = 0.000 seconds

# vapour on both sides (lower-density lattice, seeded at rho_v)
lattice      fcc ${rho_v}
lattice      fcc 0.05
Lattice spacing in x,y,z = 4.3088694 4.3088694 4.3088694
region       vapbot block INF INF INF INF 0.0 ${zlo_s} units box
region       vapbot block INF INF INF INF 0.0 34.6951767548285 units box
region       vaptop block INF INF INF INF ${zhi_s} ${Lz} units box
region       vaptop block INF INF INF INF 54.6951767548285 ${Lz} units box
region       vaptop block INF INF INF INF 54.6951767548285 89.390353509657 units box
create_atoms 1 region vapbot
Created 213 atoms
  using lattice units in orthogonal box = (0 0 0) to (10.726842 10.726842 89.390354)
  create_atoms CPU = 0.000 seconds
create_atoms 1 region vaptop
Created 200 atoms
  using lattice units in orthogonal box = (0 0 0) to (10.726842 10.726842 89.390354)
  create_atoms CPU = 0.000 seconds

mass  1 1.0
group fluid type 1
2069 atoms in group fluid

# ---- interactions. shift/tail = LAMMPS defaults (both off); stated for the record.
#      tail no: the homogeneous tail correction is invalid across an L-V interface
#      (and cancels from gamma = Pzz - (Pxx+Pyy)/2 anyway). The rcut knob is the
#      surface-tension knob, so the cutoff is the literal pair_style cutoff. ----
pair_style  lj/cut ${rcut}
pair_style  lj/cut 2.5
pair_modify shift no tail no
pair_coeff  1 1 1.0 1.0 ${rcut}
pair_coeff  1 1 1.0 1.0 2.5

neighbor     0.3 bin
neigh_modify delay 0 every 1 check yes
thermo       1000
thermo_style custom step temp pe press pxx pyy pzz   # pxx/pyy/pzz let a run watch gamma converge

# relax any liquid/vapour seed overlaps before dynamics (robust to the density knobs)
minimize 1.0e-4 1.0e-6 1000 10000
