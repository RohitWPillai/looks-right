# zero the centre-of-mass momentum so the slab does not drift under production,
# so the time-averaged z profile is not smeared by a drifting slab (no recenter needed)
velocity all create ${T} ${seed} mom yes rot no dist gaussian
velocity all create 0.85 ${seed} mom yes rot no dist gaussian
velocity all create 0.85 11 mom yes rot no dist gaussian
timestep ${dt}
timestep 0.005

# record the realised box + parameters for the analysis scripts (no hardwired dims)
print "Lx $(lx)"      file   ${outdir}/slab_params.txt
print "Lx $(lx)"      file   ./slab_params.txt
Lx 10.726842421158799823
print "Ly $(ly)"      append ${outdir}/slab_params.txt
print "Ly $(ly)"      append ./slab_params.txt
Ly 10.726842421158799823
print "Lz $(lz)"      append ${outdir}/slab_params.txt
print "Lz $(lz)"      append ./slab_params.txt
Lz 89.390353509657003883
print "tslab ${tslab}" append ${outdir}/slab_params.txt
print "tslab ${tslab}" append ./slab_params.txt
tslab 20.0
print "rho_l ${rho_l}" append ${outdir}/slab_params.txt
print "rho_l ${rho_l}" append ./slab_params.txt
rho_l 0.7
print "rho_v ${rho_v}" append ${outdir}/slab_params.txt
print "rho_v ${rho_v}" append ./slab_params.txt
rho_v 0.05
print "rcut ${rcut}"   append ${outdir}/slab_params.txt
print "rcut ${rcut}"   append ./slab_params.txt
rcut 2.5
print "T ${T}"         append ${outdir}/slab_params.txt
print "T ${T}"         append ./slab_params.txt
T 0.85
print "seed ${seed}"   append ${outdir}/slab_params.txt
print "seed ${seed}"   append ./slab_params.txt
seed 11
print "bin ${bin}"     append ${outdir}/slab_params.txt
print "bin ${bin}"     append ./slab_params.txt
bin 0.5
# run metadata, so --ensemble can reject a mixed/stale set of replicas (a live short
# run averaged in with the reference would otherwise bias the width silently)
print "nequil ${nequil}"     append ${outdir}/slab_params.txt
print "nequil ${nequil}"     append ./slab_params.txt
nequil 10000
print "nprod ${nprod}"       append ${outdir}/slab_params.txt
print "nprod ${nprod}"       append ./slab_params.txt
nprod 100000
print "dt ${dt}"             append ${outdir}/slab_params.txt
print "dt ${dt}"             append ./slab_params.txt
dt 0.005
print "tdamp ${tdamp}"       append ${outdir}/slab_params.txt
print "tdamp ${tdamp}"       append ./slab_params.txt
tdamp 1.0
print "localstress ${localstress}" append ${outdir}/slab_params.txt
print "localstress ${localstress}" append ./slab_params.txt
localstress 1
print "dump ${dump}"         append ${outdir}/slab_params.txt
print "dump ${dump}"         append ./slab_params.txt
dump 0

# ---- equilibration (Nose-Hoover NVT), then start production from step 0 ----
fix nvtall all nvt temp ${T} ${T} ${tdamp}
fix nvtall all nvt temp 0.85 ${T} ${tdamp}
fix nvtall all nvt temp 0.85 0.85 ${tdamp}
fix nvtall all nvt temp 0.85 0.85 1.0
run ${nequil}
run 10000
