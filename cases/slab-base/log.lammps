unfix nvtall
reset_timestep 0

# ---- production observables (defined AFTER equilibration so they sample production only) ----
# guard: the ave/chunk window below needs nprod >= 100 (else nrep = 0 -> no profile)
if "${nprod} < 100" then "print 'ERROR: nprod must be >= 100 for the z-profile ave/chunk output'" "quit 1"
variable nb    equal round(v_Lz/v_bin)
variable dz    equal v_Lz/v_nb
variable nrep  equal floor(v_nprod/100)         # ave/chunk: samples per block
variable nfreq equal 100*v_nrep                 # averaging window (<= nprod for nprod >= 100)
compute cbinZ fluid chunk/atom bin/1d z lower ${dz} units box   # bin/1d may add one float round-up bin past Lz; the analyser drops z>=Lz
compute cbinZ fluid chunk/atom bin/1d z lower 0.49938744977462 units box   

# number-density profile rho(z)
fix frho fluid ave/chunk 100 ${nrep} ${nfreq} cbinZ density/number file ${outdir}/slab_density.profile
fix frho fluid ave/chunk 100 1000 ${nfreq} cbinZ density/number file ${outdir}/slab_density.profile
fix frho fluid ave/chunk 100 1000 100000 cbinZ density/number file ${outdir}/slab_density.profile
fix frho fluid ave/chunk 100 1000 100000 cbinZ density/number file ./slab_density.profile

# diagonal stress components per bin (virial + kinetic, each summed; norm none).
# The analyser combines them, divides by bin volume, and integrates for gamma.
if "${localstress} > 0" then   "compute virial fluid stress/atom NULL pair"   "compute kinetic fluid stress/atom NULL ke"   "fix fpress fluid ave/chunk 100 ${nrep} ${nfreq} cbinZ c_virial[1] c_virial[2] c_virial[3] c_kinetic[1] c_kinetic[2] c_kinetic[3] norm none file ${outdir}/slab_stress.profile"
compute virial fluid stress/atom NULL pair
compute kinetic fluid stress/atom NULL ke
fix fpress fluid ave/chunk 100 ${nrep} ${nfreq} cbinZ c_virial[1] c_virial[2] c_virial[3] c_kinetic[1] c_kinetic[2] c_kinetic[3] norm none file ${outdir}/slab_stress.profile
fix fpress fluid ave/chunk 100 1000 ${nfreq} cbinZ c_virial[1] c_virial[2] c_virial[3] c_kinetic[1] c_kinetic[2] c_kinetic[3] norm none file ${outdir}/slab_stress.profile
fix fpress fluid ave/chunk 100 1000 100000 cbinZ c_virial[1] c_virial[2] c_virial[3] c_kinetic[1] c_kinetic[2] c_kinetic[3] norm none file ${outdir}/slab_stress.profile
fix fpress fluid ave/chunk 100 1000 100000 cbinZ c_virial[1] c_virial[2] c_virial[3] c_kinetic[1] c_kinetic[2] c_kinetic[3] norm none file ./slab_stress.profile

# optional orientation/intrinsic trajectory (production only; element name is for viewer colour only)
if "${dump} > 0" then   "dump dvmd fluid xyz 1000 ${outdir}/slab_traj.xyz"   "dump_modify dvmd element Ar sort id"

# ---- production (Nose-Hoover NVT at the target T; COM momentum zeroed above) ----
fix nvtprod all nvt temp ${T} ${T} ${tdamp}
fix nvtprod all nvt temp 0.85 ${T} ${tdamp}
fix nvtprod all nvt temp 0.85 0.85 ${tdamp}
fix nvtprod all nvt temp 0.85 0.85 1.0
run ${nprod}
run 100000
